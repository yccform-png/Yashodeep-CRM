# Environment Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=super-secret-institute-jwt-key-change-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=institute_admin
POSTGRES_PASSWORD=institute_secure_password_2026
POSTGRES_DB=institute_erp
DATABASE_URL=postgresql+asyncpg://institute_admin:institute_secure_password_2026@localhost:5432/institute_erp
SYNC_DATABASE_URL=postgresql://institute_admin:institute_secure_password_2026@localhost:5432/institute_erp

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Super Admin Initial Credentials
FIRST_SUPERUSER_EMAIL=admin@institute.edu
FIRST_SUPERUSER_PASSWORD=AdminSecurePass@2026!
FIRST_SUPERUSER_FIRSTNAME=Super
FIRST_SUPERUSER_LASTNAME=Admin

# Institute Master Defaults
INSTITUTE_NAME=Yashodeep Coaching Classes
INSTITUTE_CODE=YCC-MAIN
INSTITUTE_EMAIL=info@yashodeepcoachingclasses.in
INSTITUTE_PHONE=+919876543210

# External Gateways (Configurable)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Meta Cloud API - Official WhatsApp Business Platform
# If META_WHATSAPP_ENABLED is False or keys are empty, system runs in Mock Sandbox Mode
META_WHATSAPP_ENABLED=False
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=ycc_meta_webhook_secret_verify_token_2026

# Brevo (formerly Sendinblue) - Transactional Email
# If BREVO_EMAIL_ENABLED is False or API key is empty, system runs in Mock Sandbox Mode
BREVO_EMAIL_ENABLED=False
BREVO_API_KEY=
BREVO_SENDER_NAME="Yashodeep Coaching Classes"
BREVO_SENDER_EMAIL=admissions@yashodeepcoachingclasses.in
